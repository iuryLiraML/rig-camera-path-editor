# Server-only keys. Copy to `.env.local` for `npm run dev`.
# NEVER prefix these with VITE_ — Vite inlines VITE_* into the public bundle.
#
# Production / Preview: Vercel → Project → Settings → Environment Variables
# (same names), then Redeploy. Confirm GET /api/agent-config returns booleans.

ANTHROPIC_API_KEY=
KIMI_API_KEY=
FAL_KEY=

# Optional HTTP basic auth for the whole site (Vercel Edge middleware).
# SITE_USER=
# SITE_PASSWORD=
