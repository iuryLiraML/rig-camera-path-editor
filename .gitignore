# ─────────────────────────────────────────────────────────────
#  Secrets & environment — NEVER commit real keys/tokens.
#  (Security policy: no API tokens/secrets in the repo or a deploy
#   without Allie/Umberto's approval.)
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.sample            # allow a placeholder-only sample if ever needed
*.local

# credentials / key material of any kind
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
*.crt
secrets.*
*secret*.json
*credentials*.json
*serviceaccount*.json
.aws/
.npmrc
.netrc
gha-creds-*.json

# cloud / deploy tooling local state
.vercel/
.netlify/
.wrangler/

# ─────────────────────────────────────────────────────────────
#  Dependencies & build output
# ─────────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
build/
.cache/
coverage/
*.tsbuildinfo

# ─────────────────────────────────────────────────────────────
#  Logs & debug
# ─────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────────────────────────────────────────────────────
#  OS & editor cruft
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# ─────────────────────────────────────────────────────────────
#  Project-internal, non-public working files
# ─────────────────────────────────────────────────────────────
.planning/
docs/
.claude/

# in-progress cloud backend — kept out of the public frontend repo
server/
scripts/
CONTEXT.md
